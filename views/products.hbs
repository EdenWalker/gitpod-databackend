{{#extends "base"}}
{{#block "title"}}Product List{{/block}}
{{#block "content"}}
<h2 class="mb-4">Products</h2>
<table class="table table-striped table-bordered text-center">
    <thead>
        <tr>
            <th>Product ID</th>
            <th>Product Name</th>
            <th>Price</th>
            <th>Stock Quantity</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {{#each products}}
        <tr>
            <td>{{product_id}}</td>
            <td>{{product_name}}</td>
            <td>${{price}}</td> 
            <td>{{stock_quantity}}</td>
            <td>
                <a href="/products/edit/{{product_id}}" class="btn btn-info edit-button">Edit</a>
                <form action="/products/delete/{{product_id}}" method="POST" class="delete-form" style="display:inline;">
                    <button class="btn btn-danger" type="submit">Delete</button>
                </form>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>
<a href="/products/new" class="btn btn-primary">Add New Product</a>

<script>
  document.addEventListener('DOMContentLoaded', function() {
        // Select all delete forms
        const deleteForms = document.querySelectorAll('.delete-form');

        // Add event listeners to each delete form
        deleteForms.forEach(form => {
            form.addEventListener('submit', function (event) {
                const confirmDelete = confirm('Are you sure you want to delete this product?');
                if (!confirmDelete) {
                    event.preventDefault(); // Prevent the form from submitting
                }
            });
        });

        // Select all edit buttons
        const editButtons = document.querySelectorAll('.edit-button');

        // Add event listeners to each edit button
        editButtons.forEach(button => {
            button.addEventListener('click', function (event) {
                const confirmEdit = confirm('Are you sure you want to edit this product?');
                if (!confirmEdit) {
                    event.preventDefault(); // Prevent the navigation
                }
            });
        });
    });
</script>
{{/block}}
{{/extends}}
