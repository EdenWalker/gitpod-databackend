{{#extends "base"}}
{{#block "title"}}{{#if product}}Update Product{{else}}Add Product{{/if}}{{/block}}
{{#block "content"}}
<h2 class="mb-4">{{#if product}}Update Product{{else}}Add Product{{/if}}</h2>
<form action="{{#if product}}/products/edit/{{product.product_id}}{{else}}/products/new{{/if}}" method="POST" class="needs-validation" novalidate>
    <div class="mb-3">
        <label for="product_name" class="form-label">Product Name:</label>
        <input type="text" id="product_name" name="product_name" class="form-control" value="{{product.product_name}}" required>
        <div class="invalid-feedback">Please provide a product name.</div>
    </div>

    <div class="mb-3">
        <label for="price" class="form-label">Price:</label>
        <input type="number" step="0.01" id="price" name="price" class="form-control" value="{{product.price}}" required>
        <div class="invalid-feedback">Please provide a valid price.</div>
    </div>

    <div class="mb-3">
        <label for="stock_quantity" class="form-label">Stock Quantity:</label>
        <input type="number" id="stock_quantity" name="stock_quantity" class="form-control" value="{{product.stock_quantity}}" required>
        <div class="invalid-feedback">Please provide a valid stock quantity.</div>
    </div>

    <button class="btn btn-primary me-2" type="submit">{{#if product}}Update{{else}}Create{{/if}}</button>
    <a href="/products" class="btn btn-secondary">Cancel</a>
</form>


{{/block}}
{{/extends}}
