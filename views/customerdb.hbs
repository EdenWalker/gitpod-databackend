{{#extends "base"}}
{{#block "title"}}{{name}}'s Invoices{{/block}}
{{#block "content"}}
<div class="container mt-4">
    <h2>{{name}}'s Invoices</h2>
    <table class="table table-bordered table-striped text-center">
        <thead class="table-light">
            <tr>
                <th>Invoice Number</th>
                
                <th>Product Name</th>
                <th>Quantity</th>
                <th>Total Amount</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
        {{#each invoices}}
            <tr>
                <td>{{invoice_id}}</td>
             
                <td>{{product_name}}</td>
                <td>{{quantity}}</td>
                <td>{{total_amount}}</td>
                <td>{{date}}</td>
            </tr>
        {{/each}}
        </tbody>
    </table>
    <a href="/customers" class="btn btn-secondary cancel-btn">Back</a>
</div>
{{/block}}
{{/extends}}
