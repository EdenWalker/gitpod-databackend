{{#extends "base"}}
{{#block "title"}}Customers{{/block}}
{{#block "content"}}
<div class="container mt-4">
    <h2>Customers</h2>
    <table class="table table-bordered table-striped text-center">
        <thead class="table-light">
            <tr>
                <th>Customer ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {{#each customer}}
            <tr>
                <td><a href="/customers/{{customer_id}}" class="text-decoration-none">{{customer_id}}</a></td>
                <td>{{name}}</td>
                <td>{{email}}</td>
                <td>{{phone}}</td>
                <td>
                    <a href="/customers/edit/{{customer_id}}" class="btn btn-info edit-button">Edit</a>
                    <form action="/customers/delete/{{customer_id}}" method="POST" class="delete-form" style="display:inline;">
                        <button class="btn btn-danger" type="submit">Delete</button>
                    </form>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <a href="/customers/new" class="btn btn-primary">Add New Customer</a>
</div>

<script>
    // Select all delete forms
    const deleteForms = document.querySelectorAll('.delete-form');

    // Add event listeners to each delete form
    deleteForms.forEach(form => {
        form.addEventListener('submit', function (event) {
            const confirmDelete = confirm('Are you sure you want to delete this customer?');
            if (!confirmDelete) {
                event.preventDefault(); // Prevent the form from submitting
            }
        });
    });

    // Select all edit buttons
    const editButtons = document.querySelectorAll('.edit-button');

    // Add event listeners to each edit button
    editButtons.forEach(button => {
        button.addEventListener('click', function (event) {
            const confirmEdit = confirm('Are you sure you want to edit this customer?');
            if (!confirmEdit) {
                event.preventDefault(); // Prevent the navigation
            }
        });
    });
</script>
{{/block}}
{{/extends}}
