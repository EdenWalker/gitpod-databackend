{{#extends "base"}}
{{#block "title"}}{{#if invoice}}Update Invoice{{else}}Create Invoice{{/if}}{{/block}}
{{#block "content"}}
<h2 class="mb-4">{{#if invoice}}Edit Invoice{{else}}Add Invoice{{/if}}</h2>
<form action="{{#if invoice}}/invoices/edit/{{invoice.invoice_id}}{{else}}/invoices/new{{/if}}" method="POST" class="needs-validation" novalidate>
    <div class="mb-3">
        <label for="customer_id" class="form-label">Customer ID:</label>
        <input type="number" id="customer_id" name="customer_id" class="form-control" value="{{invoice.customer_id}}" required>
        <div class="invalid-feedback">Please provide a valid customer ID.</div>
    </div>

    <div class="mb-3">
        <label for="product_id" class="form-label">Product ID:</label>
        <input type="number" id="product_id" name="product_id" class="form-control" value="{{invoice.product_id}}" required>
        <div class="invalid-feedback">Please provide a valid product ID.</div>
    </div>

    <div class="mb-3">
        <label for="quantity" class="form-label">Quantity:</label>
        <input type="number" id="quantity" name="quantity" class="form-control" value="{{invoice.quantity}}" required>
        <div class="invalid-feedback">Please provide a valid quantity.</div>
    </div>

    <div class="mb-3">
        <label for="total_amount" class="form-label">Total Amount:</label>
        <input type="number" step="0.01" id="total_amount" name="total_amount" class="form-control" value="{{invoice.total_amount}}" required>
        <div class="invalid-feedback">Please provide a valid total amount.</div>
    </div>

    <div class="mb-3">
        <label for="date" class="form-label">Date:</label>
        <input type="date" id="date" name="date" class="form-control" value="{{invoice.date}}" required>
        <div class="invalid-feedback">Please select a valid date.</div>
    </div>

    <button class="btn btn-primary me-2" type="submit">{{#if invoice}}Update{{else}}Create{{/if}}</button>
    <a href="/invoices" class="btn btn-secondary">Cancel</a>
</form>


{{/block}}
{{/extends}}
